@page "/admin/experiences/edit"
@page "/admin/experiences/edit/{Id:guid}"
@attribute [Authorize(Policy = PortfolioAuthorization.AdministratorPolicy)]
@layout AdminLayout
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using Portfolio.Application.Experiences
@using Portfolio.Infrastructure.Identity
@using Portfolio.Web.Components.Shared
@using Microsoft.JSInterop
@inject IExperienceAdministrationService ExperienceService
@inject IExperienceAttachmentService AttachmentService
@inject IStringLocalizer<SharedResource> Localizer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Localizer[IsNew ? "ExperienceCreate" : "ExperienceEdit"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="admin-dashboard">
    <header class="admin-dashboard__heading">
        <MudText Typo="Typo.h1" Tag="@("h1")">@Localizer[IsNew ? "ExperienceCreate" : "ExperienceEdit"]</MudText>
    </header>

    @if (loadFailed)
    {
        <MudAlert Severity="Severity.Error" Role="alert">@Localizer["ExperienceNotFound"]</MudAlert>
    }
    else if (!loaded)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="@Localizer["Loading"]" />
    }
    else
    {
        <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" />
        <EditForm id="experience-edit-form" Model="model" OnSubmit="SaveAsync">
            <MudPaper Elevation="1" Class="pa-5 mb-4">
                <MudText Typo="Typo.h2" Tag="@("h2")">@Localizer["ExperienceDetails"]</MudText>
                <div class="experience-admin-grid">
                    <div class="admin-field">
                        <label for="experience-start-date">@Localizer["ExperienceStartDate"]</label>
                        <InputDate id="experience-start-date" @bind-Value="model.StartDate" class="mud-input-slot" />
                        @FieldErrors("StartDate")
                    </div>
                    <div class="admin-field">
                        <label for="experience-end-date">@Localizer["ExperienceEndDate"]</label>
                        <InputDate id="experience-end-date" @bind-Value="model.EndDate" class="mud-input-slot" />
                        @FieldErrors("EndDate")
                    </div>
                    <div class="admin-field">
                        <label for="experience-display-order">@Localizer["ExperienceOrder"]</label>
                        <InputNumber id="experience-display-order" @bind-Value="model.DisplayOrder" class="mud-input-slot" min="0" />
                        @FieldErrors("DisplayOrder")
                    </div>
                </div>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-5 mb-4">
                <MudText Typo="Typo.h2" Tag="@("h2")" id="experience-spanish-heading">@Localizer["ExperienceSpanish"]</MudText>
                @if (!HasSpanishTranslation)
                {
                    <MudAlert Severity="Severity.Warning" Role="status">@Localizer["ExperienceTranslationMissingSpanish"]</MudAlert>
                }
                <div class="admin-field">
                    <label for="experience-role-es">@Localizer["ExperienceRole"]</label>
                    <InputText id="experience-role-es" @bind-Value="model.SpanishRoleTitle" maxlength="200" autocomplete="organization-title" />
                    @FieldErrors("Spanish.RoleTitle")
                </div>
                <div class="admin-field">
                    <label for="experience-company-es">@Localizer["ExperienceCompany"]</label>
                    <InputText id="experience-company-es" @bind-Value="model.SpanishCompanyName" maxlength="200" autocomplete="organization" />
                    @FieldErrors("Spanish.CompanyName")
                </div>
                <div class="admin-field">
                    <label for="experience-summary-es">@Localizer["ExperienceSummary"]</label>
                    <InputTextArea id="experience-summary-es" @bind-Value="model.SpanishSummary" maxlength="@ExperienceEditValidator.MaximumSummaryLength" rows="8" />
                    @FieldErrors("Spanish.Summary")
                </div>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-5 mb-4">
                <MudText Typo="Typo.h2" Tag="@("h2")" id="experience-english-heading">@Localizer["ExperienceEnglish"]</MudText>
                @if (!HasEnglishTranslation)
                {
                    <MudAlert Severity="Severity.Warning" Role="status">@Localizer["ExperienceTranslationMissingEnglish"]</MudAlert>
                }
                <div class="admin-field">
                    <label for="experience-role-en">@Localizer["ExperienceRole"]</label>
                    <InputText id="experience-role-en" @bind-Value="model.EnglishRoleTitle" maxlength="200" autocomplete="organization-title" />
                    @FieldErrors("English.RoleTitle")
                </div>
                <div class="admin-field">
                    <label for="experience-company-en">@Localizer["ExperienceCompany"]</label>
                    <InputText id="experience-company-en" @bind-Value="model.EnglishCompanyName" maxlength="200" autocomplete="organization" />
                    @FieldErrors("English.CompanyName")
                </div>
                <div class="admin-field">
                    <label for="experience-summary-en">@Localizer["ExperienceSummary"]</label>
                    <InputTextArea id="experience-summary-en" @bind-Value="model.EnglishSummary" maxlength="@ExperienceEditValidator.MaximumSummaryLength" rows="8" />
                    @FieldErrors("English.Summary")
                </div>
            </MudPaper>

            @if (saveError is not null)
            {
                <MudAlert Severity="Severity.Error" Role="alert">@saveError</MudAlert>
            }
            @if (saveSuccess is not null)
            {
                <MudAlert Severity="Severity.Success" Role="status">@saveSuccess</MudAlert>
            }
            <div class="experience-admin-actions">
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="saving">
                    @Localizer[saving ? "ExperienceSaving" : "Save"]
                </MudButton>
                <NavLink class="button button--secondary" href="/admin/experiences" data-unsaved-navigation>@Localizer["Cancel"]</NavLink>
            </div>
        </EditForm>

        @if (!IsNew && id is { } experienceId)
        {
            <MudPaper Elevation="1" Class="pa-5 mt-6">
                <MudText Typo="Typo.h2" Tag="@("h2")">@Localizer["ExperienceAttachments"]</MudText>
                <MudText Typo="Typo.body2">@Localizer["ExperienceAttachmentRules", AttachmentService.MaximumFileCount, AttachmentService.MaximumFileSizeBytes / 1024 / 1024]</MudText>
                @if (attachments.Count < AttachmentService.MaximumFileCount)
                {
                    <div class="admin-field">
                        <label for="experience-attachment-upload">@Localizer["ExperienceAttachmentUpload"]</label>
                        <InputFile id="experience-attachment-upload" OnChange="UploadAttachmentAsync" accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                }
                @if (attachments.Count > 0)
                {
                    <div class="experience-attachment-list">
                        @foreach (var attachment in attachments)
                        {
                            <div class="experience-attachment-list__item">
                                <ExperienceAttachmentPreview @key="attachment.Id"
                                                             DisplayName="@attachment.DisplayName"
                                                             ContentType="@attachment.ContentType"
                                                             ContentUrl="@($"/admin/experiences/attachments/{attachment.Id}")" />
                                <div class="experience-attachment-list__controls">
                                    <span>@(attachment.SizeBytes / 1024) KB</span>
                                    <div class="admin-field experience-attachment-name">
                                        <label for="@($"attachment-name-{attachment.Id}")">@Localizer["ExperienceAttachmentDisplayName"]</label>
                                        <input id="@($"attachment-name-{attachment.Id}")"
                                               type="text"
                                               maxlength="255"
                                               required
                                               value="@GetDisplayNameDraft(attachment)"
                                               @oninput="@(args => SetDisplayNameDraft(attachment.Id, args))" />
                                    </div>
                                    <div class="experience-attachment-actions">
                                        <label class="experience-attachment-visibility" for="@($"attachment-public-{attachment.Id}")">
                                            <input id="@($"attachment-public-{attachment.Id}")"
                                                   type="checkbox"
                                                   checked="@GetVisibilityDraft(attachment)"
                                                   aria-describedby="@($"attachment-visibility-description-{attachment.Id}")"
                                                   @onchange="@(args => RequestAttachmentVisibilityAsync(attachment, args))" />
                                            @Localizer[attachment.IsPublic ? "ExperienceAttachmentPublic" : "ExperienceAttachmentPrivate"]
                                        </label>
                                        <MudButton OnClick="@(() => SaveAttachmentChangesAsync(attachment))"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Outlined"
                                                   Disabled="@(!CanSaveAttachmentChanges(attachment))">
                                            @Localizer["ExperienceAttachmentSaveChanges"]
                                        </MudButton>
                                        <MudButton OnClick="@(() => RequestDeleteAttachment(attachment))" Color="Color.Error" Variant="Variant.Outlined">@Localizer["Delete"]</MudButton>
                                    </div>
                                    <span id="@($"attachment-visibility-description-{attachment.Id}")" class="visually-hidden">
                                        @Localizer[attachment.IsPublic ? "ExperienceAttachmentPublicDescription" : "ExperienceAttachmentPrivateDescription"]
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (pendingDeleteAttachment is { } attachmentToDelete)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" Role="alert">
                        @Localizer["ExperienceAttachmentDeleteConfirmation", attachmentToDelete.DisplayName]
                        <MudButton OnClick="ConfirmDeleteAttachmentAsync" Color="Color.Error" Variant="Variant.Filled">@Localizer["Delete"]</MudButton>
                        <MudButton OnClick="CancelDeleteAttachment" Variant="Variant.Outlined">@Localizer["Cancel"]</MudButton>
                    </MudAlert>
                }
                @if (pendingPublicAttachment is not null)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" Role="alert">
                        @Localizer["ExperienceAttachmentPublishConfirmation", pendingPublicAttachment.DisplayName]
                        <MudButton OnClick="ConfirmPublishAttachmentAsync" Color="Color.Warning" Variant="Variant.Filled">@Localizer["ExperienceAttachmentPublish"]</MudButton>
                        <MudButton OnClick="CancelPublishAttachment" Variant="Variant.Outlined">@Localizer["Cancel"]</MudButton>
                    </MudAlert>
                }            
                @if (attachmentMessage is not null)
                {
                    <MudAlert Severity="@attachmentSeverity" Role="status">@attachmentMessage</MudAlert>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly ExperienceFormModel model = new();
    private IReadOnlyList<ExperienceAttachmentReadModel> attachments = [];
    private ExperienceAttachmentReadModel? pendingPublicAttachment;
    private ExperienceAttachmentReadModel? pendingDeleteAttachment;
    private readonly Dictionary<string, string> fieldErrors = new(StringComparer.Ordinal);
    private readonly Dictionary<Guid, string> displayNameDrafts = [];
    private readonly Dictionary<Guid, bool> visibilityDrafts = [];
    private Guid? id;
    private bool loaded;
    private bool loadFailed;
    private bool saving;
    private bool hasSpanishTranslation;
    private bool hasEnglishTranslation;
    private string? saveError;
    private string? saveSuccess;
    private ExperienceSnapshot? initialSnapshot;
    private IJSObjectReference? unsavedChangesModule;
    private bool unsavedChangesModuleInitialized;
    private bool beforeUnloadEnabled;
    private string? attachmentMessage;
    private Severity attachmentSeverity = Severity.Info;
    private bool savingDisplayName;
    private bool IsNew => Id is null;
    private bool HasSpanishTranslation => hasSpanishTranslation || TranslationIsFilled(model.SpanishRoleTitle, model.SpanishCompanyName, model.SpanishSummary);
    private bool HasEnglishTranslation => hasEnglishTranslation || TranslationIsFilled(model.EnglishRoleTitle, model.EnglishCompanyName, model.EnglishSummary);
    private bool HasUnsavedChanges => loaded
        && !loadFailed
        && initialSnapshot is not null
        && (CaptureSnapshot() != initialSnapshot || HasPendingAttachmentChanges);
    private bool HasPendingAttachmentChanges => attachments.Any(attachment =>
        HasDisplayNameChange(attachment) || HasVisibilityChange(attachment));

    private bool HasDisplayNameChange(ExperienceAttachmentReadModel attachment) =>
        !string.Equals(GetDisplayNameDraft(attachment).Trim(), attachment.DisplayName, StringComparison.Ordinal);

    private bool HasVisibilityChange(ExperienceAttachmentReadModel attachment) =>
        visibilityDrafts.TryGetValue(attachment.Id, out var isPublic) && isPublic != attachment.IsPublic;

    private bool GetVisibilityDraft(ExperienceAttachmentReadModel attachment) =>
        visibilityDrafts.TryGetValue(attachment.Id, out var isPublic) ? isPublic : attachment.IsPublic;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loaded)
        {
            return;
        }

        unsavedChangesModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/experience-unsaved-changes.js?v=12");
        if (!unsavedChangesModuleInitialized)
        {
            await unsavedChangesModule.InvokeVoidAsync(
                "initialize",
                "experience-edit-form",
                Localizer["ExperienceUnsavedChangesTitle"].Value,
                Localizer["ExperienceUnsavedChangesConfirmation"].Value,
                Localizer["StayOnPage"].Value,
                Localizer["DiscardChanges"].Value);
            unsavedChangesModuleInitialized = true;
        }

        if (beforeUnloadEnabled != HasUnsavedChanges)
        {
            beforeUnloadEnabled = HasUnsavedChanges;
            await unsavedChangesModule.InvokeVoidAsync("setEnabled", beforeUnloadEnabled);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is not { } experienceId)
        {
            model.StartDate = DateOnly.FromDateTime(DateTime.Today);
            initialSnapshot = CaptureSnapshot();
            loaded = true;
            return;
        }

        id = experienceId;
        var details = await ExperienceService.GetExperienceAsync(experienceId);
        if (details is null)
        {
            loadFailed = true;
            loaded = true;
            return;
        }

        model.StartDate = details.StartDate;
        model.EndDate = details.EndDate;
        model.DisplayOrder = details.DisplayOrder;
        model.SpanishRoleTitle = details.Spanish.RoleTitle;
        model.SpanishCompanyName = details.Spanish.CompanyName;
        model.SpanishSummary = details.Spanish.Summary;
        model.EnglishRoleTitle = details.English.RoleTitle;
        model.EnglishCompanyName = details.English.CompanyName;
        model.EnglishSummary = details.English.Summary;
        hasSpanishTranslation = details.HasSpanishTranslation;
        hasEnglishTranslation = details.HasEnglishTranslation;
        attachments = await AttachmentService.GetAttachmentsAsync(experienceId);
        initialSnapshot = CaptureSnapshot();
        loaded = true;
    }

    private async Task SaveAsync(EditContext _)
    {
        var isNewExperience = id is null;
        saving = true;
        fieldErrors.Clear();
        saveError = null;
        saveSuccess = null;
        var request = new ExperienceEditRequest(
            id,
            model.StartDate,
            model.EndDate,
            model.DisplayOrder,
            new(model.SpanishRoleTitle, model.SpanishCompanyName, model.SpanishSummary),
            new(model.EnglishRoleTitle, model.EnglishCompanyName, model.EnglishSummary));
        var result = await ExperienceService.SaveAsync(request);

        if (!result.Succeeded)
        {
            saving = false;
            foreach (var error in result.Errors)
            {
                fieldErrors[error.Field] = error.ResourceKey;
            }

            if (result.Errors.Any(error => error.ResourceKey == "ExperienceNotFound"))
            {
                saveError = Localizer["ExperienceNotFound"];
            }

            hasSpanishTranslation = TranslationIsFilled(model.SpanishRoleTitle, model.SpanishCompanyName, model.SpanishSummary);
            hasEnglishTranslation = TranslationIsFilled(model.EnglishRoleTitle, model.EnglishCompanyName, model.EnglishSummary);
            return;
        }

        id = result.ExperienceId;
        hasSpanishTranslation = true;
        hasEnglishTranslation = TranslationIsFilled(model.EnglishRoleTitle, model.EnglishCompanyName, model.EnglishSummary);
        initialSnapshot = CaptureSnapshot();
        if (!await SavePendingAttachmentChangesAsync())
        {
            saving = false;
            return;
        }

        saveSuccess = Localizer["ExperienceSaved"];
        saving = false;
        await DisableUnsavedChangesProtectionAsync();
        if (isNewExperience)
        {
            Navigation.NavigateTo($"/admin/experiences/edit/{id}");
        }
    }

    private async Task DisableUnsavedChangesProtectionAsync()
    {
        beforeUnloadEnabled = false;
        if (unsavedChangesModule is not null)
        {
            await unsavedChangesModule.InvokeVoidAsync("setEnabled", false);
        }
    }

    private async Task<bool> SavePendingAttachmentChangesAsync()
    {
        foreach (var attachment in attachments.Where(attachment =>
                     HasDisplayNameChange(attachment) || HasVisibilityChange(attachment)))
        {
            if (!await PersistAttachmentChangesAsync(attachment))
            {
                attachments = await AttachmentService.GetAttachmentsAsync(attachment.ExperienceId);
                attachmentMessage = Localizer["ExperienceAttachmentErrorNotFound"];
                attachmentSeverity = Severity.Error;
                return false;
            }

            displayNameDrafts.Remove(attachment.Id);
            visibilityDrafts.Remove(attachment.Id);
        }

        if (id is { } experienceId)
        {
            attachments = await AttachmentService.GetAttachmentsAsync(experienceId);
        }

        return true;
    }

    private ExperienceSnapshot CaptureSnapshot() => new(
        model.StartDate,
        model.EndDate,
        model.DisplayOrder,
        model.SpanishRoleTitle,
        model.SpanishCompanyName,
        model.SpanishSummary,
        model.EnglishRoleTitle,
        model.EnglishCompanyName,
        model.EnglishSummary);

    private sealed record ExperienceSnapshot(
        DateOnly StartDate,
        DateOnly? EndDate,
        int DisplayOrder,
        string SpanishRoleTitle,
        string SpanishCompanyName,
        string SpanishSummary,
        string EnglishRoleTitle,
        string EnglishCompanyName,
        string EnglishSummary);

    public async ValueTask DisposeAsync()
    {
        if (unsavedChangesModule is null)
        {
            return;
        }

        try
        {
            await unsavedChangesModule.InvokeVoidAsync("setEnabled", false);
            await unsavedChangesModule.InvokeVoidAsync("dispose");
            await unsavedChangesModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private RenderFragment FieldErrors(string field) => builder =>
    {
        if (fieldErrors.TryGetValue(field, out var resourceKey))
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "admin-field__error");
            builder.AddAttribute(2, "role", "alert");
            builder.AddContent(3, Localizer[resourceKey]);
            builder.CloseElement();
        }
    };

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs args)
    {
        if (id is not { } experienceId)
        {
            return;
        }

        attachmentMessage = null;
        try
        {
            var file = args.File;
            await using var content = file.OpenReadStream(AttachmentService.MaximumFileSizeBytes);
            var result = await AttachmentService.UploadAsync(
                experienceId,
                file.Name,
                file.ContentType,
                file.Size,
                content);
            if (result.Succeeded)
            {
                attachments = await AttachmentService.GetAttachmentsAsync(experienceId);
                attachmentMessage = Localizer["ExperienceAttachmentUploaded"];
                attachmentSeverity = Severity.Success;
            }
            else
            {
                attachmentMessage = Localizer[$"ExperienceAttachmentError{result.Error}"];
                attachmentSeverity = Severity.Error;
            }
        }
        catch (IOException)
        {
            attachmentMessage = Localizer["ExperienceAttachmentErrorTooLarge"];
            attachmentSeverity = Severity.Error;
        }
    }

    private string GetDisplayNameDraft(ExperienceAttachmentReadModel attachment) =>
        displayNameDrafts.TryGetValue(attachment.Id, out var displayName)
            ? displayName
            : attachment.DisplayName;

    private void SetDisplayNameDraft(Guid attachmentId, ChangeEventArgs args)
    {
        if (args.Value is string displayName)
        {
            displayNameDrafts[attachmentId] = displayName;
        }
    }

    private bool CanSaveAttachmentChanges(ExperienceAttachmentReadModel attachment)
    {
        var displayName = GetDisplayNameDraft(attachment).Trim();
        return !savingDisplayName
            && displayName.Length is > 0 and <= 255
            && (HasDisplayNameChange(attachment) || HasVisibilityChange(attachment));
    }

    private async Task SaveAttachmentChangesAsync(ExperienceAttachmentReadModel attachment)
    {
        if (!CanSaveAttachmentChanges(attachment))
        {
            return;
        }

        savingDisplayName = true;
        try
        {
            if (await PersistAttachmentChangesAsync(attachment))
            {
                attachments = await AttachmentService.GetAttachmentsAsync(attachment.ExperienceId);
                displayNameDrafts.Remove(attachment.Id);
                visibilityDrafts.Remove(attachment.Id);
                attachmentMessage = Localizer["ExperienceAttachmentChangesSaved"];
                attachmentSeverity = Severity.Success;
            }
            else
            {
                attachmentMessage = Localizer["ExperienceAttachmentErrorNotFound"];
                attachmentSeverity = Severity.Error;
            }
        }

        finally
        {
            savingDisplayName = false;
        }
    }

    private async Task<bool> PersistAttachmentChangesAsync(ExperienceAttachmentReadModel attachment)
    {
        if (HasDisplayNameChange(attachment)
            && !await AttachmentService.UpdateDisplayNameAsync(attachment.Id, GetDisplayNameDraft(attachment).Trim()))
        {
            return false;
        }

        return !HasVisibilityChange(attachment)
            || await AttachmentService.SetPublicAsync(attachment.Id, GetVisibilityDraft(attachment));
    }

    private Task RequestAttachmentVisibilityAsync(
        ExperienceAttachmentReadModel attachment,
        ChangeEventArgs args)
    {
        var isPublic = args.Value is bool value
            ? value
            : string.Equals(Convert.ToString(args.Value), "true", StringComparison.OrdinalIgnoreCase);
        if (isPublic == GetVisibilityDraft(attachment))
        {
            return Task.CompletedTask;
        }

        if (isPublic)
        {
            pendingPublicAttachment = attachment;
            attachmentMessage = null;
            return Task.CompletedTask;
        }

        SetVisibilityDraft(attachment, isPublic);
        return Task.CompletedTask;
    }

    private Task ConfirmPublishAttachmentAsync()
    {
        if (pendingPublicAttachment is not { } attachment)
        {
            return Task.CompletedTask;
        }

        pendingPublicAttachment = null;
        SetVisibilityDraft(attachment, isPublic: true);
        attachmentMessage = Localizer["ExperienceAttachmentPublicationPending"];
        attachmentSeverity = Severity.Warning;
        return Task.CompletedTask;
    }

    private void CancelPublishAttachment() => pendingPublicAttachment = null;

    private void SetVisibilityDraft(ExperienceAttachmentReadModel attachment, bool isPublic)
    {
        if (isPublic == attachment.IsPublic)
        {
            visibilityDrafts.Remove(attachment.Id);
        }
        else
        {
            visibilityDrafts[attachment.Id] = isPublic;
        }
    }

    private void RequestDeleteAttachment(ExperienceAttachmentReadModel attachment)
    {
        pendingDeleteAttachment = attachment;
        attachmentMessage = null;
    }

    private void CancelDeleteAttachment() => pendingDeleteAttachment = null;

    private async Task ConfirmDeleteAttachmentAsync()
    {
        if (pendingDeleteAttachment is not { } attachment || id is not { } experienceId)
        {
            return;
        }

        pendingDeleteAttachment = null;
        if (!await AttachmentService.DeleteAsync(attachment.Id))
        {
            attachmentMessage = Localizer["ExperienceAttachmentErrorNotFound"];
            attachmentSeverity = Severity.Error;
            return;
        }

        displayNameDrafts.Remove(attachment.Id);
        visibilityDrafts.Remove(attachment.Id);
        attachments = await AttachmentService.GetAttachmentsAsync(experienceId);
        attachmentMessage = Localizer["ExperienceAttachmentDeleted"];
        attachmentSeverity = Severity.Success;
    }

    private static bool TranslationIsFilled(string role, string company, string summary) =>
        !string.IsNullOrWhiteSpace(role) && !string.IsNullOrWhiteSpace(company) && !string.IsNullOrWhiteSpace(summary);

    private sealed class ExperienceFormModel
    {
        public DateOnly StartDate { get; set; }
        public DateOnly? EndDate { get; set; }
        public int DisplayOrder { get; set; }
        public string SpanishRoleTitle { get; set; } = string.Empty;
        public string SpanishCompanyName { get; set; } = string.Empty;
        public string SpanishSummary { get; set; } = string.Empty;
        public string EnglishRoleTitle { get; set; } = string.Empty;
        public string EnglishCompanyName { get; set; } = string.Empty;
        public string EnglishSummary { get; set; } = string.Empty;
    }
}
