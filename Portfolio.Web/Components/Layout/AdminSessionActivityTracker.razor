@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<AdminSessionActivityTracker> Logger

<form id="admin-session-activity-form" action="/admin/session/activity" method="post" hidden>
    <AntiforgeryToken />
</form>

@code {
    private IJSObjectReference? module;
    private bool initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/admin-session-activity.js");
        await module.InvokeVoidAsync("startMonitoring", "admin-session-activity-form");
    }

    public async ValueTask DisposeAsync()
    {
        var currentModule = module;
        if (currentModule is null)
        {
            return;
        }

        try
        {
            var stopwatch = System.Diagnostics.Stopwatch.StartNew();

            try
            {
                await currentModule.InvokeVoidAsync("stopMonitoring");
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(
                    ex,
                    "JS interop {Operation} no pudo completarse: el circuito está desconectado. Duración: {ElapsedMilliseconds} ms.",
                    "stopMonitoring",
                    stopwatch.ElapsedMilliseconds);
            }
            catch (TaskCanceledException ex)
            {
                Logger.LogWarning(
                    ex,
                    "JS interop {Operation} se canceló durante la disposición. Duración: {ElapsedMilliseconds} ms. Token cancelable: {CanBeCanceled}; cancelado: {IsCancellationRequested}.",
                    "stopMonitoring",
                    stopwatch.ElapsedMilliseconds,
                    ex.CancellationToken.CanBeCanceled,
                    ex.CancellationToken.IsCancellationRequested);
            }
        }
        finally
        {
            var stopwatch = System.Diagnostics.Stopwatch.StartNew();

            try
            {
                await currentModule.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(
                    ex,
                    "JS interop {Operation} no pudo completarse: el circuito está desconectado. Duración: {ElapsedMilliseconds} ms.",
                    "module.DisposeAsync",
                    stopwatch.ElapsedMilliseconds);
            }
            catch (TaskCanceledException ex)
            {
                Logger.LogWarning(
                    ex,
                    "JS interop {Operation} se canceló durante la disposición. Duración: {ElapsedMilliseconds} ms. Token cancelable: {CanBeCanceled}; cancelado: {IsCancellationRequested}.",
                    "module.DisposeAsync",
                    stopwatch.ElapsedMilliseconds,
                    ex.CancellationToken.CanBeCanceled,
                    ex.CancellationToken.IsCancellationRequested);
            }
        }
    }
}
