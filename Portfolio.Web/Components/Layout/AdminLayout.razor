@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using Portfolio.Infrastructure.Identity
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<AuthorizeView Policy="@PortfolioAuthorization.AdministratorPolicy">
<Authorized>
<div class="admin-layout">
    <header class="admin-header">
                <NavLink class="portfolio-logo" href="/admin" Match="NavLinkMatch.All" data-unsaved-navigation>
                    <span class="portfolio-logo__mark" aria-hidden="true">[ LOGO ]</span>
                </NavLink>
        <div class="admin-header__controls">
            <ThemeSelector />
            <LanguageSelector />
            <form id="admin-header-logout-form" class="admin-account" action="/admin/logout" method="post">
                <AntiforgeryToken />
                <button class="button button--secondary admin-logout-icon" type="submit" aria-label="@Localizer["AdminLogout"]" title="@Localizer["AdminLogout"]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M10 17l5-5-5-5M15 12H3m9-9h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></svg>
                </button>
            </form>
        </div>
    </header>
    <div class="admin-shell">
        <nav class="admin-navigation" aria-label="@Localizer["AdminNavigation"]">
            <NavLink class="admin-navigation__link" href="/admin" Match="NavLinkMatch.All" data-unsaved-navigation>@Localizer["AdminDashboard"]</NavLink>
            <NavLink class="admin-navigation__link" href="/admin/experiences" data-unsaved-navigation>@Localizer["AdminExperiences"]</NavLink>
            <NavLink class="admin-navigation__link" href="/admin/projects" data-unsaved-navigation>@Localizer["AdminProjects"]</NavLink>
            <NavLink class="admin-navigation__link" href="/admin/certifications" data-unsaved-navigation>@Localizer["AdminCertifications"]</NavLink>
            <span class="admin-navigation__item" aria-disabled="true">@Localizer["AdminBlog"]</span>
            <NavLink class="admin-navigation__link" href="/" Match="NavLinkMatch.All" data-unsaved-navigation>@Localizer["AdminPublicSiteAction"]</NavLink>
        </nav>
        <main class="admin-main" id="admin-main" tabindex="-1">
            @Body
        </main>
    </div>
    <AdminSessionActivityTracker />
</div>
</Authorized>
</AuthorizeView>

@code {
}
