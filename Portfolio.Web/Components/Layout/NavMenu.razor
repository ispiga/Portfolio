@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Portfolio.Infrastructure.Identity
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> Localizer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<nav class="portfolio-navbar @(isMenuOpen ? "is-menu-open" : string.Empty)" aria-label="@Localizer["MainNavigation"]">
    <div class="portfolio-shell portfolio-navbar__content">
        <NavLink class="portfolio-logo" href="/" Match="NavLinkMatch.All" @onclick="GoHome" data-unsaved-navigation>
            <PortfolioBrandImage AlternativeText="@Localizer["PortfolioName"]" />
            <span class="portfolio-logo__name">ISMAELPI</span>
        </NavLink>

        <button class="portfolio-menu-toggle" type="button" aria-controls="portfolio-navigation" aria-expanded="@isMenuOpen" @onclick="ToggleMenu">
            <span class="portfolio-menu-toggle__icon" aria-hidden="true">☰</span>
            <span>@Localizer[isMenuOpen ? "CloseMenu" : "OpenMenu"]</span>
        </button>

        <div id="portfolio-navigation" class="portfolio-navbar__panel @(isMenuOpen ? "is-open" : string.Empty)">
            <ul class="portfolio-navigation__list">
                <li><a class="@(IsCurrent("about") ? "is-active" : string.Empty)" href="/#about" @onclick="SelectAbout" @onclick:preventDefault="true" data-unsaved-navigation>@Localizer["About"]</a></li>
                <li><a class="@(IsCurrent("projects") ? "is-active" : string.Empty)" href="/#projects" @onclick="SelectProjects" @onclick:preventDefault="true" data-unsaved-navigation>@Localizer["Projects"]</a></li>
                <li><a class="@(IsCurrent("certificates") ? "is-active" : string.Empty)" href="/#certificates" @onclick="SelectCertificates" @onclick:preventDefault="true" data-unsaved-navigation>@Localizer["Certificates"]</a></li>
                <li><a class="@(IsCurrent("blog") ? "is-active" : string.Empty)" href="@BlogHref" @onclick="SelectBlog" @onclick:preventDefault="true" data-unsaved-navigation>@Localizer["Blog"]</a></li>
                <li><a class="@(IsCurrent("contact") ? "is-active" : string.Empty)" href="/#contact" @onclick="SelectContact" @onclick:preventDefault="true" data-unsaved-navigation>@Localizer["Contact"]</a></li>
                <AuthorizeView Policy="@PortfolioAuthorization.AdministratorPolicy">
                    <Authorized>
                        <li>
                            <NavLink class="portfolio-navigation__icon-link" href="/admin" @onclick="CloseMenu" aria-label="@Localizer["AdminDashboardTitle"]" title="@Localizer["AdminDashboardTitle"]" data-unsaved-navigation>
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" /><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.6a8 8 0 0 1-1.5.9l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.6-.9l-1.7.6-1.4-2.4 1.4-1.1a7 7 0 0 1 0-1.9l-1.4-1.1 1.4-2.4 1.7.6a8 8 0 0 1 1.6-.9l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.5.9l1.7-.6 1.4 2.4-1.4 1.1a7 7 0 0 1-.1 1.8Z" transform="translate(-1 -1)" /></svg>
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <ThemeSelector />
            <LanguageSelector />
            <AuthorizeView Policy="@PortfolioAuthorization.AdministratorPolicy">
                <Authorized>
                    <div class="portfolio-account" aria-label="@Localizer["AdminNavigation"]">
                        <form id="public-navbar-logout-form" action="/admin/logout" method="post">
                            <AntiforgeryToken />
                            <button class="button button--secondary admin-logout-icon" type="submit" aria-label="@Localizer["AdminLogout"]" title="@Localizer["AdminLogout"]">
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M10 17l5-5-5-5M15 12H3m9-9h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></svg>
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private bool isMenuOpen;
    private string? activeSection;
    private IJSObjectReference? scrollModule;
    private string? pendingSectionId;
    private bool pendingScrollToTop;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                scrollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/home-navbar-scroll.js");
            }

            if (scrollModule is null)
            {
                return;
            }

            if (pendingSectionId is { } sectionId)
            {
                pendingSectionId = null;
                await scrollModule.InvokeVoidAsync("scrollToSection", sectionId);
            }
            else if (pendingScrollToTop)
            {
                pendingScrollToTop = false;
                await scrollModule.InvokeVoidAsync("scrollToTop");
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void CloseMenu() => isMenuOpen = false;

    private void GoHome()
    {
        activeSection = null;
        CloseMenu();
    }

    private void SelectAbout() => SelectSection("about");

    private void SelectProjects() => SelectSection("projects");

    private void SelectCertificates() => SelectSection("certificates");

    private void SelectBlog()
    {
        activeSection = "blog";
        CloseMenu();

        if (IsBlogDetail)
        {
            pendingScrollToTop = true;
            Navigation.NavigateTo("/blog");
        }
        else if (IsBlogArchive)
        {
            pendingScrollToTop = true;
        }
        else
        {
            pendingSectionId = "blog";
            Navigation.NavigateTo("/#blog");
        }
    }

    private void SelectContact() => SelectSection("contact");

    private void SelectSection(string section)
    {
        activeSection = section;
        CloseMenu();
        Navigation.NavigateTo($"/#{section}");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            activeSection = null;
            CloseMenu();
            StateHasChanged();
        });
    }

    private bool IsCurrent(string section)
    {
        if (activeSection is not null)
        {
            return string.Equals(activeSection, section, StringComparison.OrdinalIgnoreCase);
        }

        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativeUri.Split('#', 2)[0].Split('?', 2)[0].Trim('/');
        if (section == "blog" &&
            (string.Equals(path, "blog", StringComparison.OrdinalIgnoreCase) || path.StartsWith("blog/", StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        var fragment = relativeUri.Split('#', 2).ElementAtOrDefault(1);
        return string.Equals(fragment, section, StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('#', 2)[0]
        .Split('?', 2)[0]
        .Trim('/');

    private bool IsBlogArchive => string.Equals(CurrentPath, "blog", StringComparison.OrdinalIgnoreCase);

    private bool IsBlogDetail => CurrentPath.StartsWith("blog/", StringComparison.OrdinalIgnoreCase);

    private string BlogHref => IsBlogArchive || IsBlogDetail ? "/blog" : "/#blog";

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (scrollModule is null)
        {
            return;
        }

        try
        {
            await scrollModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
