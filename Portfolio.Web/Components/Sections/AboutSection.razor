@using Microsoft.Extensions.Localization
@using Portfolio.Application.HomeContent
@inject IStringLocalizer<SharedResource> Localizer
@inject IAboutQueryService AboutQueryService

<section id="about" class="home-section" aria-labelledby="about-title">
    <div class="section-heading">
        <p class="eyebrow">@Localizer["AboutEyebrow"]</p>
        <h2 id="about-title">@Localizer["AboutTitle"]</h2>
    </div>
    <section class="about-composition" aria-label="@Localizer["AboutAreasLabel"]">
        <div class="surface content-card about-profile">
            <span class="about-pin" aria-hidden="true">
                <span class="about-pin__head"></span>
                <span class="about-pin__needle"></span>
            </span>
            <p>@(content?.Profile ?? Localizer["AboutProfileEmpty"].Value)</p>
        </div>
        <div class="about-skills">
            @if (content is { Groups.Count: > 0 })
            {
                @foreach (var group in content.Groups)
                {
                    <article class="surface area-card">
                        <h3>@group.Name</h3>
                        <ul class="about-skill-list">
                            @foreach (var skill in group.Skills)
                            {
                                <li>@skill.Name</li>
                            }
                        </ul>
                        <svg class="about-skills__fold-line" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                            <path d="M-0.75 18.75 L18.75 -0.75" />
                        </svg>
                    </article>
                }
            }
            else
            {
                <p class="about-content-empty">@Localizer["AboutAreasEmpty"]</p>
            }
        </div>
    </section>
    @if (content is { Hobbies.Count: > 0 })
    {
        <section class="about-hobbies" aria-labelledby="about-hobbies-title">
            <h3 id="about-hobbies-title">@Localizer["AboutHobbies"]</h3>
            <div class="about-hobbies-grid">
                @foreach (var hobby in content.Hobbies)
                {
                    <article class="surface about-hobby-card">
                        <img src="@hobby.ImageUrl" alt="@hobby.Name" loading="lazy" />
                        <div>
                            <h4>@hobby.Name</h4>
                            <p>@hobby.Description</p>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    <ExperienceTimeline />
</section>

@code {
    private AboutContentReadModel? content;

    protected override async Task OnInitializedAsync() => content = await AboutQueryService.GetAsync();
}
