@using Microsoft.Extensions.Localization
@using Portfolio.Application.HomeContent
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResource> Localizer
@inject IAboutQueryService AboutQueryService
@inject IJSRuntime JS
@inject ILogger<AboutSection> Logger

<section @ref="aboutElement" id="about" class="home-section" aria-labelledby="about-title">
    <div class="section-heading">
        <p class="eyebrow">@Localizer["AboutEyebrow"]</p>
        <h2 id="about-title">@Localizer["AboutTitle"]</h2>
    </div>
    <section class="about-composition" aria-label="@Localizer["AboutAreasLabel"]">
        <div class="surface content-card about-profile">
            <span class="about-pin" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" fill="none" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 15-6 6M15 6l-1-1 2-2 5 5-2 2-1-1-4.5 4.5c1.5 1.5 1 4-.5 5.5l-8-8c1.5-1.5 4-2 5.5-.5z"></path>
                </svg>
            </span>
            <p>@(content?.Profile ?? Localizer["AboutProfileEmpty"].Value)</p>
        </div>
        <div class="about-skills">
            @if (content is { Groups.Count: > 0 })
            {
                @foreach (var group in content.Groups)
                {
                    <article class="surface area-card @(string.IsNullOrWhiteSpace(group.BackgroundColor) ? string.Empty : "area-card--custom-color")"
                             style="@GetGroupColorStyle(group.BackgroundColor)">
                        <h3>@group.Name</h3>
                        <ul class="about-skill-list">
                            @foreach (var skill in group.Skills)
                            {
                                <li>@skill.Name</li>
                            }
                        </ul>
                    </article>
                }
            }
            else
            {
                <p class="about-content-empty">@Localizer["AboutAreasEmpty"]</p>
            }
        </div>
    </section>
    @if (content is { Hobbies.Count: > 0 })
    {
        <section class="about-hobbies" aria-labelledby="about-hobbies-title">
            <h3 id="about-hobbies-title">@Localizer["AboutHobbies"]</h3>
            <div class="about-hobbies-grid">
                @foreach (var hobby in content.Hobbies)
                {
                    <article @key="hobby.Id" class="surface about-hobby-card">
                        <button type="button"
                                class="about-hobby-card__image-button"
                                aria-label="@Localizer["HobbyImageEnlarge", hobby.Name]"
                                @onclick="() => OpenHobbyImage(hobby.ImageUrl, hobby.Name)">
                            <img src="@hobby.ImageUrl" alt="" loading="lazy" />
                        </button>
                        <div class="about-hobby-card__content">
                            <h4>@hobby.Name</h4>
                            <p id="hobby-description-@hobby.Id"
                               data-hobby-id="@hobby.Id"
                               class="about-hobby-card__description @(expandedHobbyDescriptions.Contains(hobby.Id) ? "is-expanded" : string.Empty)">@hobby.Description</p>
                            @if (truncatedHobbyDescriptions.Contains(hobby.Id))
                            {
                                <button class="button button--secondary about-hobby-card__description-toggle"
                                        type="button"
                                        aria-expanded="@expandedHobbyDescriptions.Contains(hobby.Id)"
                                        aria-controls="hobby-description-@hobby.Id"
                                        @onclick="() => ToggleHobbyDescription(hobby.Id)">
                                    @Localizer[expandedHobbyDescriptions.Contains(hobby.Id) ? "HobbyDescriptionCollapse" : "HobbyDescriptionExpand"]
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    <ExperienceTimeline />
</section>
@if (expandedHobbyImageUrl is not null)
{
    <div class="hobby-image-lightbox"
         @ref="lightboxElement"
         role="dialog"
         aria-modal="true"
         aria-label="@Localizer["HobbyImagePreview", expandedHobbyName ?? string.Empty]"
         tabindex="-1"
         @onclick="CloseHobbyImage"
         @onkeydown="HandleLightboxKeyDown">
        <div class="hobby-image-lightbox__content" @onclick:stopPropagation="true">
            <button @ref="lightboxCloseButton"
                    type="button"
                    class="hobby-image-lightbox__close"
                    aria-label="@Localizer["Close"]"
                    @onclick="CloseHobbyImage">×</button>
            <img src="@expandedHobbyImageUrl" alt="@expandedHobbyName" />
        </div>
    </div>
}

@code {
    private AboutContentReadModel? content;
    private string? expandedHobbyImageUrl;
    private string? expandedHobbyName;
    private ElementReference lightboxCloseButton;
    private ElementReference lightboxElement;
    private ElementReference aboutElement;
    private IJSObjectReference? hobbyDescriptionModule;
    private IJSObjectReference? lightboxModule;
    private DotNetObjectReference<AboutSection>? objectReference;
    private readonly HashSet<Guid> expandedHobbyDescriptions = [];
    private readonly HashSet<Guid> truncatedHobbyDescriptions = [];
    private bool focusLightboxCloseButton;
    private bool restoreLightboxFocus;
    private readonly CancellationTokenSource jsLifetimeCancellation = new();
    private readonly SemaphoreSlim jsModuleLock = new(1, 1);
    private bool disposed;

    protected override async Task OnInitializedAsync() => content = await AboutQueryService.GetAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await jsModuleLock.WaitAsync(jsLifetimeCancellation.Token);
        }
        catch (OperationCanceledException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About section JS initialization was canceled while waiting for the module lock.");
            return;
        }

        try
        {
            if (disposed)
            {
                return;
            }

            if (focusLightboxCloseButton)
            {
                focusLightboxCloseButton = false;
                await lightboxCloseButton.FocusAsync();
                if (disposed)
                {
                    return;
                }

                if (lightboxModule is not null)
                {
                    await lightboxModule.InvokeVoidAsync("activate", jsLifetimeCancellation.Token, lightboxElement);
                }
            }

            if (restoreLightboxFocus)
            {
                restoreLightboxFocus = false;
                if (lightboxModule is not null)
                {
                    await lightboxModule.InvokeVoidAsync("deactivate", jsLifetimeCancellation.Token);
                }
            }

            if (!firstRender || disposed)
            {
                return;
            }

            hobbyDescriptionModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                jsLifetimeCancellation.Token,
                "./js/about-hobby-descriptions.js");
            if (disposed)
            {
                return;
            }

            objectReference = DotNetObjectReference.Create(this);
            await hobbyDescriptionModule.InvokeVoidAsync(
                "observeDescriptions",
                jsLifetimeCancellation.Token,
                aboutElement,
                objectReference);
        }
        catch (JSDisconnectedException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About section JS initialization ended after component disposal.");
        }
        catch (OperationCanceledException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About section JS initialization was canceled during component disposal.");
        }
        finally
        {
            jsModuleLock.Release();
        }
    }

    private void ToggleHobbyDescription(Guid hobbyId)
    {
        if (!expandedHobbyDescriptions.Add(hobbyId))
        {
            expandedHobbyDescriptions.Remove(hobbyId);
        }
    }

    [JSInvokable]
    public Task UpdateTruncatedHobbyDescriptions(string[] hobbyIds)
    {
        if (disposed)
        {
            return Task.CompletedTask;
        }

        var updatedIds = hobbyIds
            .Select(id => Guid.TryParse(id, out var hobbyId) ? hobbyId : Guid.Empty)
            .Where(id => id != Guid.Empty)
            .ToHashSet();

        if (truncatedHobbyDescriptions.SetEquals(updatedIds))
        {
            return Task.CompletedTask;
        }

        truncatedHobbyDescriptions.Clear();
        truncatedHobbyDescriptions.UnionWith(updatedIds);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        jsLifetimeCancellation.Cancel();
        await jsModuleLock.WaitAsync();
        try
        {
            var cleanupErrors = new List<Exception>();
            var currentHobbyDescriptionModule = hobbyDescriptionModule;
            hobbyDescriptionModule = null;
            if (currentHobbyDescriptionModule is not null)
            {
                await TryInvokeLifecycleInteropAsync(
                    cleanupErrors,
                    () => currentHobbyDescriptionModule.InvokeVoidAsync("stopObservingDescriptions", aboutElement),
                    "stopObservingDescriptions");
                await TryInvokeLifecycleInteropAsync(cleanupErrors, currentHobbyDescriptionModule.DisposeAsync, "hobbyDescriptionModule.DisposeAsync");
            }

            var currentLightboxModule = lightboxModule;
            lightboxModule = null;
            if (currentLightboxModule is not null)
            {
                await TryInvokeLifecycleInteropAsync(cleanupErrors, () => currentLightboxModule.InvokeVoidAsync("deactivate"), "deactivate");
                await TryInvokeLifecycleInteropAsync(cleanupErrors, currentLightboxModule.DisposeAsync, "lightboxModule.DisposeAsync");
            }

            objectReference?.Dispose();
            objectReference = null;

            if (cleanupErrors.Count == 1)
            {
                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(cleanupErrors[0]).Throw();
            }

            if (cleanupErrors.Count > 1)
            {
                throw new AggregateException("About section JavaScript cleanup failed.", cleanupErrors);
            }
        }
        finally
        {
            jsModuleLock.Release();
            jsLifetimeCancellation.Dispose();
        }
    }

    private async Task OpenHobbyImage(string imageUrl, string name)
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await jsModuleLock.WaitAsync(jsLifetimeCancellation.Token);
        }
        catch (OperationCanceledException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About image lightbox initialization was canceled while waiting for the module lock.");
            return;
        }

        try
        {
            if (disposed)
            {
                return;
            }

            lightboxModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                jsLifetimeCancellation.Token,
                "./js/hobby-image-lightbox.js");
            if (disposed)
            {
                return;
            }

            await lightboxModule.InvokeVoidAsync("rememberFocus", jsLifetimeCancellation.Token);
        }
        catch (JSDisconnectedException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About image lightbox initialization ended after component disposal.");
            return;
        }
        catch (OperationCanceledException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About image lightbox initialization was canceled during component disposal.");
            return;
        }
        finally
        {
            jsModuleLock.Release();
        }

        if (disposed)
        {
            return;
        }

        expandedHobbyImageUrl = imageUrl;
        expandedHobbyName = name;
        focusLightboxCloseButton = true;
    }

    private async ValueTask TryInvokeLifecycleInteropAsync(
        List<Exception> cleanupErrors,
        Func<ValueTask> operation,
        string operationName)
    {
        try
        {
            await operation();
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, "About section JS {Operation} could not complete because the circuit disconnected.", operationName);
        }
        catch (OperationCanceledException exception) when (disposed)
        {
            Logger.LogDebug(exception, "About section JS {Operation} was canceled during component disposal.", operationName);
        }
        catch (Exception exception)
        {
            cleanupErrors.Add(exception);
        }
    }

    private void CloseHobbyImage()
    {
        restoreLightboxFocus = expandedHobbyImageUrl is not null;
        expandedHobbyImageUrl = null;
        expandedHobbyName = null;
    }

    private void HandleLightboxKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseHobbyImage();
        }
    }

    private static string? GetGroupColorStyle(string? color) =>
        color is { Length: 7 } && color[0] == '#' && color.AsSpan(1).ToString().All(Uri.IsHexDigit)
            ? $"--skill-group-color: {color};"
            : null;
}
