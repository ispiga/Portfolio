@using Microsoft.Extensions.Localization
@using System.Globalization
@using Portfolio.Application.Experiences
@using Portfolio.Web.Components.Shared
@inject IStringLocalizer<SharedResource> Localizer
@inject IExperienceQueryService ExperienceQueryService

<section class="home-section" aria-labelledby="experience-title">
    <div class="section-heading">
        <p class="eyebrow">@Localizer["ExperienceEyebrow"]</p>
        <h2 id="experience-title">@Localizer["ExperienceTitle"]</h2>
    </div>
    @if (experiences is { Count: > 0 })
    {
        <ol class="experience-timeline">
            @foreach (var experience in experiences)
            {
                <li class="experience-timeline__item">
                    <article class="experience-card surface">
                        <div class="experience-card__date">
                            <time datetime="@experience.StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                @experience.StartDate.ToString("MMM yyyy", CultureInfo.CurrentUICulture)
                            </time>
                            <span aria-hidden="true">@Localizer["ExperienceDateSeparator"]</span>
                            @if (experience.EndDate is { } endDate)
                            {
                                <time datetime="@endDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                    @endDate.ToString("MMM yyyy", CultureInfo.CurrentUICulture)
                                </time>
                            }
                            else
                            {
                                <span>@Localizer["ExperienceCurrent"]</span>
                            }
                        </div>
                        <div>
                            <h3>@experience.RoleTitle</h3>
                            <p class="experience-card__company">@experience.CompanyName</p>
                            <p id="experience-description-@experience.Id" class="experience-card__description @(expandedDescriptions.Contains(experience.Id) ? "is-expanded" : string.Empty)">@experience.Summary</p>
                            <button class="button button--secondary experience-card__description-toggle"
                                    type="button"
                                    aria-expanded="@expandedDescriptions.Contains(experience.Id)"
                                    aria-controls="experience-description-@experience.Id"
                                    @onclick="() => ToggleDescription(experience.Id)">
                                @Localizer[expandedDescriptions.Contains(experience.Id) ? "ExperienceDescriptionCollapse" : "ExperienceDescriptionExpand"]
                            </button>
                            @if (experience.Attachments is { Count: > 0 } publicAttachments)
                            {
                                <section class="experience-public-attachments" aria-label="@Localizer["ExperiencePublicAttachments"]">
                                    <h4>@Localizer["ExperiencePublicAttachments"]</h4>
                                    <div class="experience-public-attachments__grid">
                                        @foreach (var attachment in publicAttachments)
                                        {
                                            <ExperienceAttachmentPreview @key="attachment.Id"
                                                                         OriginalFileName="attachment.OriginalFileName"
                                                                         ContentType="attachment.ContentType"
                                                                         ContentUrl="@($"/experience-attachments/{attachment.Id}")" />
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </article>
                </li>
            }
        </ol>
    }
    else if (experiences is not null)
    {
        <div class="timeline-empty surface">
            <span class="timeline-empty__marker" aria-hidden="true"></span>
            <p>@Localizer["ExperienceEmpty"]</p>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ExperienceReadModel>? experiences;
    private readonly HashSet<Guid> expandedDescriptions = [];

    private void ToggleDescription(Guid experienceId)
    {
        if (!expandedDescriptions.Add(experienceId))
        {
            expandedDescriptions.Remove(experienceId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        experiences = await ExperienceQueryService.GetExperiencesAsync();
    }
}
