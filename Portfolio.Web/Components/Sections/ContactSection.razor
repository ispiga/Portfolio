@using Microsoft.Extensions.Localization
@using Portfolio.Application.Contact
@using Portfolio.Web.Components.Shared
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS

<section id="contact" class="home-section" aria-labelledby="contact-title">
    <div class="section-heading"><p class="eyebrow">@Localizer["ContactEyebrow"]</p><h2 id="contact-title">@Localizer["ContactTitle"]</h2><p>@Localizer["ContactIntro"]</p></div>
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="surface contact-form">
        <AntiforgeryToken />
        <LocalizedDataAnnotationsValidator />
        <p class="form-note">@Localizer["ContactFormNote"]</p>
        <div class="form-grid">
            <div class="form-field">
                <label for="contact-name">@Localizer["ContactName"]</label>
                <InputText id="contact-name" @bind-Value="model.Name" autocomplete="name" disabled="@isSubmitting" />
                <ValidationMessage For="@(() => model.Name)" />
            </div>
            <div class="form-field">
                <label for="contact-email">@Localizer["ContactEmail"]</label>
                <InputText id="contact-email" @bind-Value="model.Email" type="email" autocomplete="email" disabled="@isSubmitting" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>
        </div>
        <div class="form-field">
            <label for="contact-message">@Localizer["ContactMessage"]</label>
            <InputTextArea id="contact-message" @bind-Value="model.Message" rows="5" disabled="@isSubmitting" />
            <ValidationMessage For="@(() => model.Message)" />
        </div>
        <div class="contact-form__honeypot" aria-hidden="true">
            <label for="contact-company">@Localizer["ContactHoneypotLabel"]</label>
            <InputText id="contact-company" @bind-Value="model.Honeypot" tabindex="-1" autocomplete="off" />
        </div>
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="form-status" role="status" aria-live="polite">@statusMessage</p>
        }
        <button class="button button--primary" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? Localizer["ContactSending"] : Localizer["ContactSubmit"])
        </button>
    </EditForm>
</section>

@code {
    private ContactRequest model = new();
    private bool isSubmitting;
    private string statusMessage = string.Empty;

    private async Task HandleValidSubmit()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        statusMessage = Localizer["ContactSending"].Value;

        try
        {
            var response = await JS.InvokeAsync<ContactSubmissionResponse>("portfolioContact.submit", model);
            if (response.StatusCode == 429)
            {
                statusMessage = Localizer["ContactRateLimited"].Value;
                return;
            }

            statusMessage = response.Result switch
            {
                "sent" when response.StatusCode is >= 200 and < 300 => Localizer["ContactSuccess"].Value,
                "rejected" => Localizer["ContactError"].Value,
                "invalid" => Localizer["ContactValidationError"].Value,
                _ => Localizer["ContactError"].Value
            };

            if (response.Result == "sent" && response.StatusCode is >= 200 and < 300)
            {
                model = new ContactRequest();
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit(EditContext _)
    {
        statusMessage = Localizer["ContactValidationError"].Value;
    }

    private sealed record ContactSubmissionResponse(int StatusCode, string? Result);
}
