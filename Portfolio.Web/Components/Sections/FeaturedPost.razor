@using Microsoft.Extensions.Localization
@using Portfolio.Application.Blog
@inject IStringLocalizer<SharedResource> Localizer
@inject IBlogPostQueryService BlogPostQueryService

<section id="blog" class="home-section" aria-labelledby="blog-title">
    <div class="section-heading"><p class="eyebrow">@Localizer["BlogEyebrow"]</p><h2 id="blog-title">@Localizer["BlogTitle"]</h2></div>
    @if (posts.Count > 0)
    {
        <div class="blog-home__posts">
            @foreach (var post in posts)
            {
                <BlogPostSummaryCard Post="post" />
            }
        </div>
        <a class="button button--secondary blog-home__all" href="/blog">@Localizer["BlogViewAll"]</a>
    }
    else if (hasLoaded)
    {
        <p class="blog-home__empty">@Localizer["BlogEmpty"]</p>
    }
</section>

@code {
    private IReadOnlyList<BlogPostReadModel> posts = [];
    private bool hasLoaded;

    protected override async Task OnInitializedAsync()
    {
        posts = await BlogPostQueryService.GetHomePostsAsync();
        hasLoaded = true;
    }
}
