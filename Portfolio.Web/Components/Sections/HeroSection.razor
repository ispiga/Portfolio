@using Microsoft.Extensions.Localization
@using global::System.Globalization
@using Portfolio.Application.HomeContent
@inject IStringLocalizer<SharedResource> Localizer
@inject IHeroQueryService HeroQueryService

<section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero__content">
        <p class="home-hero__eyebrow">@Localizer["HeroEyebrow"]</p>
        <h1 id="hero-title">@(hero?.Headline ?? Localizer["HeroTitle"].Value)</h1>
        <p class="home-hero__description">@(hero?.Description ?? Localizer["HeroDescription"].Value)</p>
        <div class="home-hero__actions">
            <a class="button button--primary" href="#contact">
                @Localizer["HeroCta"]
            </a>

            <div class="home-hero__socials social-links" aria-label="Perfiles sociales">
                <a class="social-links__link" href="https://www.linkedin.com/in/ipinzon"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Visitar mi perfil de LinkedIn">
                    <svg class="social-links__icon" aria-hidden="true" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.26 2.37 4.26 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>
                    </svg>
                </a>

                <a class="social-links__link" href="https://github.com/ispiga"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Ver mis repositorios en GitHub">
                    <svg class="social-links__icon" aria-hidden="true" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3.01 0 4.27-2.61 5.21-5.1 5.49.4.35.75 1.02.75 2.06v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
    @if (hero is { Logos.Count: > 0 } || !string.IsNullOrWhiteSpace(hero?.ProfileImageUrl))
    {
        <div class="technology-orbit" aria-label="@Localizer["TechnologyVisualLabel"]">
            <svg class="technology-orbit__tracks" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="technology-orbit__track technology-orbit__track--orbit-1" d="M 31.932284 64.917964 A 25.2 21.4 0 0 1 68.067716 35.082036" />
                <path class="technology-orbit__track technology-orbit__track--orbit-2" d="M 24.488802 71.063821 A 35.6 30.2 0 0 1 75.511198 28.936179" />
                <path class="technology-orbit__track technology-orbit__track--orbit-3" d="M 17.045332 77.209668 A 46 39 0 0 1 82.954668 22.790332" />
            </svg>
            <div class="technology-orbit__core">
                @if (!string.IsNullOrWhiteSpace(hero.ProfileImageUrl))
                {
                    <img src="@hero.ProfileImageUrl" alt="@hero.ProfileImageAlternativeText" />
                }   
                else
                {
                    <span aria-hidden="true">@Localizer["TechnologyCore"]</span>
                }
            </div>
            <svg class="technology-orbit__tracks technology-orbit__tracks--front" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="technology-orbit__track technology-orbit__track--orbit-1" d="M 68.067716 35.082036 A 25.2 21.4 0 0 1 31.932284 64.917964" />
                <path class="technology-orbit__track technology-orbit__track--orbit-2" d="M 75.511198 28.936179 A 35.6 30.2 0 0 1 24.488802 71.063821" />
                <path class="technology-orbit__track technology-orbit__track--orbit-3" d="M 82.954668 22.790332 A 46 39 0 0 1 17.045332 77.209668" />
            </svg>
            <div class="technology-orbit__plane">
                @foreach (var orbit in hero.Logos.GroupBy(logo => ((logo.Orbit - 1) % 3) + 1).OrderBy(group => group.Key))
                {
                    var logos = orbit.OrderBy(logo => logo.DisplayOrder).ThenBy(logo => logo.Id).ToArray();
                    var orbitNumber = orbit.Key;
                    var duration = 46 + orbitNumber * 7;
                    var orbitDirection = orbitNumber == 2 ? "reverse" : "normal";
                    <div class="technology-orbit__orbit-layer technology-orbit__orbit-layer--orbit-@orbitNumber">
                        @for (var index = 0; index < logos.Length; index++)
                        {
                            var delay = -(double)duration * index / logos.Length;
                            var startDistance = 100d * (orbitNumber == 2 ? 1d - (double)index / logos.Length : (double)index / logos.Length);
                            <span class="technology-orbit__item technology-orbit__item--orbit-@orbitNumber" style="--orbit-duration: @($"{duration}s"); --orbit-direction: @orbitDirection; --orbit-distance: @($"{startDistance.ToString("0.##", CultureInfo.InvariantCulture)}%"); animation-delay: @($"{delay.ToString("0.##", CultureInfo.InvariantCulture)}s");">
                                <span class="technology-orbit__item-counter">
                                    <img class="technology-orbit__item-image" src="@logos[index].ImageUrl" alt="@logos[index].AlternativeText" width="36" height="36" />
                                </span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private HeroReadModel? hero;

    protected override async Task OnInitializedAsync() => hero = await HeroQueryService.GetAsync();
}
