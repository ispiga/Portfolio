@using Microsoft.Extensions.Localization
@using Portfolio.Application.Projects
@inject IStringLocalizer<SharedResource> Localizer

<article class="surface project-card @(Project.IsFeatured ? "project-card--featured" : string.Empty)">
    @if (!string.IsNullOrWhiteSpace(Project.PreviewImagePath))
    {
        <img class="project-card__image" src="@Project.PreviewImagePath" alt="@Project.Title" loading="lazy" />
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>

        <div class="project-card__visual" aria-hidden="true">@Localizer["ProjectVisualPlaceholder"]</div>
    }

    <div class="project-card__content">
        @if (Project.IsFeatured)
        {
            <p class="project-card__featured">@Localizer["ProjectFeatured"]</p>
        }

        <h3>@Project.Title</h3>
        <p>@Project.Summary</p>

        @if (!string.IsNullOrWhiteSpace(Project.Description))
        {
            <button type="button"
                    class="project-card__description-toggle"
                    aria-expanded="@descriptionExpanded"
                    aria-controls="@DescriptionId"
                    @onclick="ToggleDescription">
                @Localizer[descriptionExpanded ? "ProjectDescriptionCollapse" : "ProjectDescriptionExpand"]
            </button>
            <p id="@DescriptionId" class="project-card__description" hidden="@(!descriptionExpanded)">@Project.Description</p>
        }

        @if (!string.IsNullOrWhiteSpace(Project.RepositoryUrl) || !string.IsNullOrWhiteSpace(Project.DemoUrl))
        {
            <div class="project-card__links">
                @if (!string.IsNullOrWhiteSpace(Project.RepositoryUrl))
                {
                    <a class="button" href="@Project.RepositoryUrl" target="_blank" rel="noopener noreferrer">@Localizer["ProjectRepository"]</a>
                }

                @if (!string.IsNullOrWhiteSpace(Project.DemoUrl))
                {
                    <a class="button button--primary" href="@Project.DemoUrl" target="_blank" rel="noopener noreferrer">@Localizer["ProjectDemo"]</a>
                }
            </div>
        }
    </div>
</article>

@code {
    private bool descriptionExpanded;

    private string DescriptionId => $"project-description-{Project.Id:N}";

    [Parameter, EditorRequired]
    public ProjectReadModel Project { get; set; } = null!;

    private void ToggleDescription() => descriptionExpanded = !descriptionExpanded;
}
