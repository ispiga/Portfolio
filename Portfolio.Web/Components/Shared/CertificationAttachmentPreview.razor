@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer

<button class="certification-attachment-preview" type="button" aria-label="@Localizer["CertificationAttachmentOpen", DisplayName]" @onclick="OpenDocumentAsync">
    @if (ContentType == "application/pdf")
    {
        @if (previewFailed)
        {
            <span class="certification-attachment-preview__fallback" aria-hidden="true">PDF</span>
        }
        else
        {
            <canvas @ref="pdfCanvas" class="certification-attachment-preview__pdf" aria-hidden="true"></canvas>
        }
        <span class="certification-attachment-preview__label">PDF</span>
    }
    else
    {
        <img src="@ContentUrl" alt="" loading="lazy" />
    }
    <span class="certification-attachment-preview__name">@DisplayName</span>
</button>

<dialog @ref="documentDialog" class="certification-document-dialog" aria-label="@Localizer["CertificationAttachmentDialog", selectedDisplayName ?? string.Empty]" @onclick="CloseDocumentAsync">
    <div class="certification-document-dialog__surface" @onclick:stopPropagation="true">
        <header class="certification-document-dialog__header">
            <h2>@selectedDisplayName</h2>
            <button class="button button--secondary" type="button" @onclick="CloseDocumentAsync">@Localizer["Close"]</button>
        </header>
        @if (selectedContentType == "application/pdf")
        {
            <iframe class="certification-document-dialog__pdf" src="@selectedContentUrl" title="@Localizer["CertificationAttachmentDocument", selectedDisplayName ?? string.Empty]"></iframe>
        }
        else if (!string.IsNullOrWhiteSpace(selectedContentUrl))
        {
            <div class="certification-document-dialog__image-container">
                <img class="certification-document-dialog__image" src="@selectedContentUrl" alt="@selectedDisplayName" />
            </div>
        }
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ContentType { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ContentUrl { get; set; } = string.Empty;

    private ElementReference pdfCanvas;
    private ElementReference documentDialog;
    private IJSObjectReference? pdfModule;
    private IJSObjectReference? documentViewerModule;
    private DotNetObjectReference<CertificationAttachmentPreview>? dotNetReference;
    private bool previewFailed;
    private string? selectedDisplayName;
    private string? selectedContentType;
    private string? selectedContentUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            documentViewerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/certification-document-viewer.js");
            dotNetReference = DotNetObjectReference.Create(this);
            await documentViewerModule.InvokeVoidAsync("initialize", documentDialog, dotNetReference);

            if (ContentType == "application/pdf")
            {
                pdfModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/experience-pdf-preview.js");
                await pdfModule.InvokeVoidAsync("renderFirstPage", ContentUrl, pdfCanvas);
            }
        }
        catch (JSException)
        {
            if (ContentType == "application/pdf")
            {
                previewFailed = true;
                StateHasChanged();
            }
        }
    }

    private async Task OpenDocumentAsync()
    {
        selectedDisplayName = DisplayName;
        selectedContentType = ContentType;
        selectedContentUrl = ContentUrl;

        if (documentViewerModule is not null)
        {
            await documentViewerModule.InvokeVoidAsync("show", documentDialog);
        }
    }

    private async Task CloseDocumentAsync()
    {
        if (documentViewerModule is not null)
        {
            await documentViewerModule.InvokeVoidAsync("close", documentDialog);
        }
    }

    [JSInvokable]
    public Task OnDocumentDialogClosed()
    {
        selectedDisplayName = null;
        selectedContentType = null;
        selectedContentUrl = null;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (documentViewerModule is not null)
        {
            try
            {
                await documentViewerModule.InvokeVoidAsync("dispose", documentDialog);
                await documentViewerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dotNetReference?.Dispose();

        if (pdfModule is not null)
        {
            try
            {
                await pdfModule.InvokeVoidAsync("disposePreview", pdfCanvas);
                await pdfModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
