@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject ILogger<CertificationAttachmentPreview> Logger

<button class="certification-attachment-preview" type="button" aria-label="@Localizer["CertificationAttachmentOpen", DisplayName]" @onclick="OpenDocumentAsync">
    @if (ContentType == "application/pdf")
    {
        <div class="pdf-preview-frame" aria-busy="@previewLoading">
            <canvas @ref="pdfCanvas" class="certification-attachment-preview__pdf" aria-hidden="true"></canvas>
            @if (previewLoading)
            {
                <span class="pdf-preview-state" role="status">@Localizer["PdfPreviewLoading"]</span>
            }
            else if (previewFailed)
            {
                <span class="pdf-preview-state pdf-preview-state--error" role="alert">@Localizer["PdfPreviewFailed"]</span>
            }
            else if (!previewLoaded)
            {
                <span class="pdf-preview-state" aria-hidden="true">PDF</span>
            }
        </div>
        <span class="certification-attachment-preview__label">PDF</span>
    }
    else
    {
        <img src="@ContentUrl" alt="" loading="lazy" />
    }
    <span class="certification-attachment-preview__name">@DisplayName</span>
</button>

<dialog @ref="documentDialog" class="certification-document-dialog" aria-label="@Localizer["CertificationAttachmentDialog", selectedDisplayName ?? string.Empty]" @onclick="CloseDocumentAsync">
    <div class="certification-document-dialog__surface" @onclick:stopPropagation="true">
        <header class="certification-document-dialog__header">
            <h2>@selectedDisplayName</h2>
            <button class="button button--secondary" type="button" @onclick="CloseDocumentAsync">@Localizer["Close"]</button>
        </header>
        @if (selectedContentType == "application/pdf")
        {
            <iframe class="certification-document-dialog__pdf" src="@selectedContentUrl" title="@Localizer["CertificationAttachmentDocument", selectedDisplayName ?? string.Empty]"></iframe>
        }
        else if (!string.IsNullOrWhiteSpace(selectedContentUrl))
        {
            <div class="certification-document-dialog__image-container">
                <img class="certification-document-dialog__image" src="@selectedContentUrl" alt="@selectedDisplayName" />
            </div>
        }
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ContentType { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ContentUrl { get; set; } = string.Empty;

    private ElementReference pdfCanvas;
    private ElementReference documentDialog;
    private IJSObjectReference? pdfModule;
    private IJSObjectReference? documentViewerModule;
    private DotNetObjectReference<CertificationAttachmentPreview>? dotNetReference;
    private bool previewFailed;
    private bool previewLoading;
    private bool previewLoaded;
    private bool disposed;
    private int disposalStarted;
    private readonly CancellationTokenSource componentLifetime = new();
    private string? selectedDisplayName;
    private string? selectedContentType;
    private string? selectedContentUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed)
        {
            return;
        }

        var cancellationToken = componentLifetime.Token;
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            documentViewerModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", cancellationToken, "./js/certification-document-viewer.js");
            dotNetReference = DotNetObjectReference.Create(this);
            await documentViewerModule.InvokeVoidAsync("initialize", cancellationToken, documentDialog, dotNetReference);

            if (ContentType == "application/pdf")
            {
                Logger.LogDebug("Importando el módulo JS de vista previa PDF para un adjunto de certificación.");
                pdfModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", cancellationToken, "./js/experience-pdf-preview.js");
                Logger.LogDebug("Módulo JS de vista previa PDF importado en {ElapsedMilliseconds} ms.", stopwatch.ElapsedMilliseconds);
                await pdfModule.InvokeVoidAsync("observeFirstPage", cancellationToken, ContentUrl, pdfCanvas, dotNetReference);
            }
        }
        catch (OperationCanceledException exception) when (cancellationToken.IsCancellationRequested)
        {
            Logger.LogDebug(exception,
                "Interoperabilidad de vista previa cancelada porque el componente se estaba eliminando. Duración: {ElapsedMilliseconds} ms.",
                stopwatch.ElapsedMilliseconds);
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception,
                "El circuito se desconectó durante la inicialización de la vista previa de certificación. Duración: {ElapsedMilliseconds} ms.",
                stopwatch.ElapsedMilliseconds);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogWarning(exception,
                "La interop de vista previa de certificación se canceló sin que el componente se estuviera eliminando. Duración: {ElapsedMilliseconds} ms.",
                stopwatch.ElapsedMilliseconds);
            MarkPreviewFailed();
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "No se pudo inicializar la vista previa de certificación.");
            MarkPreviewFailed();
        }
    }

    private void MarkPreviewFailed()
    {
        if (disposed || ContentType != "application/pdf")
        {
            return;
        }

        previewFailed = true;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnPdfPreviewLoading() => InvokeAsync(() =>
    {
        if (disposed)
        {
            return;
        }

        previewLoading = true;
        previewFailed = false;
        previewLoaded = false;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnPdfPreviewLoaded() => InvokeAsync(() =>
    {
        if (disposed)
        {
            return;
        }

        previewLoading = false;
        previewLoaded = true;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnPdfPreviewFailed(string errorType) => InvokeAsync(() =>
    {
        if (disposed)
        {
            return;
        }

        Logger.LogWarning("Falló la vista previa PDF de una certificación. Tipo de error JS: {ErrorType}.", errorType);
        previewLoading = false;
        previewFailed = true;
        StateHasChanged();
    });

    private async Task OpenDocumentAsync()
    {
        selectedDisplayName = DisplayName;
        selectedContentType = ContentType;
        selectedContentUrl = ContentUrl;

        if (documentViewerModule is not null)
        {
            await documentViewerModule.InvokeVoidAsync("show", documentDialog);
        }
    }

    private async Task CloseDocumentAsync()
    {
        if (documentViewerModule is not null)
        {
            await documentViewerModule.InvokeVoidAsync("close", documentDialog);
        }
    }

    [JSInvokable]
    public Task OnDocumentDialogClosed()
    {
        if (disposed)
        {
            return Task.CompletedTask;
        }

        selectedDisplayName = null;
        selectedContentType = null;
        selectedContentUrl = null;
        return InvokeAsync(() =>
        {
            if (!disposed)
            {
                StateHasChanged();
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref disposalStarted, 1) != 0)
        {
            return;
        }

        disposed = true;
        componentLifetime.Cancel();

        try
        {
            if (documentViewerModule is not null)
            {
                try
                {
                    await documentViewerModule.InvokeVoidAsync("dispose", documentDialog);
                }
                catch (JSDisconnectedException exception)
                {
                    Logger.LogDebug(exception, "No se pudo limpiar el visor: el circuito ya estaba desconectado.");
                }
                catch (OperationCanceledException exception)
                {
                    Logger.LogDebug(exception, "La limpieza del visor se canceló durante la eliminación del componente.");
                }
                catch (JSException exception)
                {
                    Logger.LogWarning(exception, "Falló la limpieza del visor de certificación.");
                }

                try
                {
                    await documentViewerModule.DisposeAsync();
                }
                catch (JSDisconnectedException exception)
                {
                    Logger.LogDebug(exception, "No se pudo liberar el módulo visor: el circuito ya estaba desconectado.");
                }
                catch (OperationCanceledException exception)
                {
                    Logger.LogDebug(exception, "La liberación del módulo visor se canceló durante la eliminación del componente.");
                }
                catch (JSException exception)
                {
                    Logger.LogWarning(exception, "Falló la liberación del módulo visor de certificación.");
                }
            }

            if (pdfModule is not null)
            {
                try
                {
                    await pdfModule.InvokeVoidAsync("disposePreview", pdfCanvas);
                    await pdfModule.DisposeAsync();
                }
                catch (JSDisconnectedException exception)
                {
                    Logger.LogDebug(exception, "No se pudo limpiar la vista previa PDF: el circuito ya estaba desconectado.");
                }
                catch (OperationCanceledException exception)
                {
                    Logger.LogDebug(exception, "La limpieza de la vista previa PDF se canceló durante la eliminación del componente.");
                }
                catch (JSException exception)
                {
                    Logger.LogWarning(exception, "Falló la limpieza de la vista previa PDF de certificación.");
                }

                try
                {
                    await pdfModule.DisposeAsync();
                }
                catch (JSDisconnectedException exception)
                {
                    Logger.LogDebug(exception, "No se pudo liberar el módulo PDF: el circuito ya estaba desconectado.");
                }
                catch (OperationCanceledException exception)
                {
                    Logger.LogDebug(exception, "La liberación del módulo PDF se canceló durante la eliminación del componente.");
                }
                catch (JSException exception)
                {
                    Logger.LogWarning(exception, "Falló la liberación del módulo PDF de certificación.");
                }
            }

        }
        finally
        {
            dotNetReference?.Dispose();
            componentLifetime.Dispose();
        }
    }
}
