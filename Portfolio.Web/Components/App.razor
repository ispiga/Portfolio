<!DOCTYPE html>
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Portfolio.Application.VisualIdentity
@using Portfolio.Web.Authentication
@inject IVisualIdentityQueryService VisualIdentityService
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    @if (identity is not null)
    {
        <link id="visual-identity-theme-stylesheet" rel="stylesheet" href="@VisualIdentityEndpoints.ThemeStylesheetUrl(identity.AssetVersion)" />
    }
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap integrity="@importMapIntegrity" />
    @if (identity is not null)
    {
        <link rel="icon" type="@identity.FaviconContentType" href="@identity.FaviconUrl" />
    }
    <HeadOutlet />
</head>

<body>
    <MudThemeProvider DefaultScrollbar="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <Routes />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/contact-submission.js"]"></script>
    <script src="@Assets["js/admin-login.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private VisualIdentitySettingsModel? identity;
    private string? importMapIntegrity;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        identity = await VisualIdentityService.GetAsync();
        importMapIntegrity = ImportMapCspIntegrity.GetIntegrity(HttpContext);
    }

}
