<!DOCTYPE html>
@using System.Globalization
@using Portfolio.Application.VisualIdentity
@inject IVisualIdentityQueryService VisualIdentityService
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Portfolio.Web.styles.css"]" />
    @if (identity is not null)
    {
        <style>
            :root {
                --color-primary: @SafeColor(identity.PrimaryColor, VisualIdentityValidator.DefaultPrimaryColor);
                --color-secondary: @SafeColor(identity.SecondaryColor, VisualIdentityValidator.DefaultSecondaryColor);
                --color-accent: @SafeColor(identity.AccentColor, VisualIdentityValidator.DefaultAccentColor);
                --color-primary-contrast: @VisualIdentityValidator.ContrastingTextColor(identity.PrimaryColor);
                --color-secondary-contrast: @VisualIdentityValidator.ContrastingTextColor(identity.SecondaryColor);
                --color-accent-contrast: @VisualIdentityValidator.ContrastingTextColor(identity.AccentColor);
            }
            .mud-theme-provider {
                --mud-palette-primary: var(--color-primary) !important;
                --mud-palette-primary-text: var(--color-primary-contrast) !important;
                --mud-palette-secondary: var(--color-secondary) !important;
                --mud-palette-secondary-text: var(--color-secondary-contrast) !important;
                --mud-palette-tertiary: var(--color-accent) !important;
                --mud-palette-tertiary-text: var(--color-accent-contrast) !important;
                --mud-palette-background: var(--color-background) !important;
                --mud-palette-background-gray: var(--color-background) !important;
                --mud-palette-surface: var(--color-surface) !important;
                --mud-palette-text-primary: var(--color-text) !important;
                --mud-palette-text-secondary: var(--color-text-secondary) !important;
                --mud-palette-divider: var(--color-border) !important;
                --mud-palette-lines-default: var(--color-border) !important;
                --mud-palette-table-lines: var(--color-border) !important;
                --mud-palette-table-hover: var(--color-background) !important;
            }
        </style>
    }
    <ImportMap />
    @if (identity is not null)
    {
        <link rel="icon" type="@identity.FaviconContentType" href="@identity.FaviconUrl" />
    }
    <HeadOutlet />
</head>

<body>
    <MudThemeProvider />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <Routes />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/contact-submission.js"]"></script>
    <script src="@Assets["js/admin-login.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private VisualIdentitySettingsModel? identity;

    protected override async Task OnInitializedAsync()
    {
        identity = await VisualIdentityService.GetAsync();
    }

    private static string SafeColor(string color, string fallback) =>
        VisualIdentityValidator.IsHexColor(color) ? color : fallback;

}
