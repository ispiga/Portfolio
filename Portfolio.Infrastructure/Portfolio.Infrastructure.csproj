<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
	<EmbeddedResource Include="..\docs\brand\logo_portfolio.svg" Link="Assets\logo_portfolio.svg" LogicalName="Portfolio.Infrastructure.Assets.logo_portfolio.svg" />
	<EmbeddedResource Include="Assets\default-favicon.svg" LogicalName="Portfolio.Infrastructure.Assets.default-favicon.svg" />
	<ProjectReference Include="..\Portfolio.Application\Portfolio.Application.csproj" />
	<ProjectReference Include="..\Portfolio.Domain\Portfolio.Domain.csproj" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
	<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
	<PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
	<PackageReference Include="MailKit" Version="4.18.0" />
